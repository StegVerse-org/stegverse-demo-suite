{
  "schema": "stegverse.demo-evaluator-profile.v2",
  "profile_id": "stegverse-general-evaluator-v2",
  "purpose": "identity-neutral frozen evaluation and development surface governed by the StegVerse SDK relationship",
  "recipient_specific": false,
  "authority_effect": "NONE",
  "frozen_state_required": true,
  "terms_acceptance_required": true,
  "relationship_manager": "StegVerse-org/StegVerse-SDK",
  "network_required_to_build": false,
  "network_required_to_verify": false,
  "github_actions_required": false,
  "render_required": false,
  "direct_external_stegverse_connections": [],
  "sdk_mediated_routes": [
    "StegGhost/entity-sandbox-runner",
    "StegVerse-org/LLM-adapter:evaluator-entry"
  ],
  "llm_adapter_direct_access": false,
  "prohibited_authority": [
    "production_activation",
    "heartbeat_control",
    "governance_authority",
    "wallet_signing",
    "transaction_broadcast",
    "custody",
    "provider_credential_access",
    "TV/TVC capability material",
    "private repository access"
  ],
  "included_roots": [
    "README.md",
    "LICENSE",
    "docs",
    "demos",
    "stegverse",
    "tests",
    "scripts/discover.py",
    "config/evaluator_capability_catalog.json",
    "config/evaluator_license_manifest.json",
    "ACTION_GOVERNANCE_NOTES.txt",
    "MAX_RUNTIME_NOTES.txt",
    "MUTATION_GOVERNANCE_NOTES.txt",
    "RUNTIME_WRAPPER_NOTES.txt",
    "SMOKE_TEST_ACTION_GOVERNANCE.json",
    "SMOKE_TEST_MAX_RUNTIME.json",
    "SMOKE_TEST_MUTATION_GOVERNANCE.json",
    "SMOKE_TEST_RUNTIME_WRAPPER.json"
  ],
  "optional_frozen_payload_root": "frozen_payload",
  "excluded_path_names": [
    ".git",
    ".github",
    ".stegverse_runtime",
    "__pycache__",
    ".pytest_cache",
    ".mypy_cache",
    ".venv",
    "venv",
    "dist",
    "build",
    "node_modules",
    ".env",
    "runtime-secrets",
    "secrets"
  ],
  "prohibited_filename_fragments": [
    "private_key",
    "seed_phrase",
    "mnemonic",
    "api_key",
    "apikey",
    "credential",
    "password"
  ],
  "bundle_manifest": "EVALUATOR_MANIFEST.json",
  "bundle_readme": "EVALUATOR_README.md",
  "capability_catalog": "config/evaluator_capability_catalog.json",
  "license_manifest": "config/evaluator_license_manifest.json",
  "explorer_mode": "READ_ONLY_PUBLIC_DEMOS",
  "frozen_payload_authority": "IMMUTABLE_COPIED_ARTIFACTS_ONLY"
}
