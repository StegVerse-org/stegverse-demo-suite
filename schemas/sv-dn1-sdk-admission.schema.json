{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stegverse.org/schemas/sv-dn1-sdk-admission.schema.json",
  "title": "SV-DN-1 Canonical SDK Admission Binding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "state",
    "exchange_id",
    "sdk_request_id",
    "sdk_result_binding_hash",
    "sdk_intake",
    "governance_state",
    "route",
    "custody",
    "claims",
    "authority_effect"
  ],
  "properties": {
    "schema_version": {
      "const": "stegverse.sv-dn1.sdk-admission/v1"
    },
    "state": {
      "const": "SDK_ADMITTED"
    },
    "exchange_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "sdk_request_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 80
    },
    "sdk_result_binding_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "sdk_intake": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest_hash",
        "intake_receipt_id",
        "binding_state"
      ],
      "properties": {
        "manifest_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "intake_receipt_id": {
          "type": "string",
          "pattern": "^MR-[A-F0-9]{16,64}$"
        },
        "binding_state": {
          "const": "SDK_ADMITTED"
        }
      }
    },
    "governance_state": {
      "enum": [
        "ALLOW",
        "DENY",
        "REVIEW",
        "FAIL_CLOSED"
      ]
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "route_id",
        "route_declaration_hash",
        "state_binding_hash",
        "route_receipt_ids",
        "route_receipt_chain_head",
        "route_transition_count",
        "transaction_id",
        "transaction_identity_continuous"
      ],
      "properties": {
        "route_id": {
          "const": "stegverse.route.canonical-governed.v1"
        },
        "route_declaration_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "state_binding_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "route_receipt_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "route_receipt_chain_head": {
          "type": "string",
          "minLength": 1
        },
        "route_transition_count": {
          "type": "integer",
          "minimum": 1
        },
        "transaction_id": {
          "type": "string",
          "minLength": 1
        },
        "transaction_identity_continuous": {
          "const": true
        }
      }
    },
    "custody": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "master_records_custody_status",
        "chain_verified"
      ],
      "properties": {
        "master_records_custody_status": {
          "const": "RECORDED"
        },
        "chain_verified": {
          "const": true
        }
      }
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sdk_governed_run_observed",
        "master_records_custody_observed",
        "certification_claimed",
        "hugging_face_endorsement_claimed",
        "canonical_interlock_adoption_claimed",
        "production_interlock_runtime_activation_claimed"
      ],
      "properties": {
        "sdk_governed_run_observed": {
          "const": true
        },
        "master_records_custody_observed": {
          "const": true
        },
        "certification_claimed": {
          "const": false
        },
        "hugging_face_endorsement_claimed": {
          "const": false
        },
        "canonical_interlock_adoption_claimed": {
          "const": false
        },
        "production_interlock_runtime_activation_claimed": {
          "const": false
        }
      }
    },
    "authority_effect": {
      "const": "NONE"
    }
  }
}
