{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stegverse.org/schemas/sv-dn1-intr-runtime-receipt.schema.json",
  "title": "SV-DN-1 Route-Specific InTr Runtime Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_hash",
    "route_id",
    "exchange_id",
    "state",
    "observed_at",
    "transport_profile",
    "source_transform_hash",
    "previous_receipt_hash",
    "destination_validation",
    "lineage_verified",
    "claims",
    "authority_effect"
  ],
  "properties": {
    "schema_version": {
      "const": "stegverse.sv-dn1.intr-runtime-receipt/v1"
    },
    "receipt_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "route_id": {
      "const": "SV-DN-1-HF-PUBLIC"
    },
    "exchange_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "state": {
      "const": "COMPLETE"
    },
    "observed_at": {
      "type": "string",
      "minLength": 1
    },
    "transport_profile": {
      "const": "stegverse.universal-intr.adjacent-hop/v1"
    },
    "source_transform_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "previous_receipt_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "destination_validation": {
      "const": "PASS"
    },
    "lineage_verified": {
      "const": true
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_protocol_adopted",
        "universal_intr_policy_id",
        "boundary_from",
        "boundary_to",
        "interlock_required_per_hop",
        "receipt_hash_chain_required",
        "runtime_activation_claimed",
        "production_interlock_runtime_activated",
        "sdk_admitted",
        "hugging_face_endorsement_claimed",
        "credential_used"
      ],
      "properties": {
        "canonical_protocol_adopted": {
          "const": true
        },
        "production_interlock_runtime_activated": {
          "const": false
        },
        "sdk_admitted": {
          "const": false
        },
        "hugging_face_endorsement_claimed": {
          "const": false
        },
        "credential_used": {
          "const": false
        },
        "universal_intr_policy_id": {
          "const": "STEGVERSE-UNIVERSAL-INTR-TRANSPORT-001"
        },
        "boundary_from": {
          "const": "EXTERNAL_SYSTEM"
        },
        "boundary_to": {
          "const": "STEGOS_ECOSYSTEM"
        },
        "interlock_required_per_hop": {
          "const": true
        },
        "receipt_hash_chain_required": {
          "const": true
        },
        "runtime_activation_claimed": {
          "const": false
        }
      }
    },
    "authority_effect": {
      "const": "NONE"
    }
  }
}
